# Copy to .env and fill in. Never commit a populated .env.
# Every value below is optional -- with none of them set, everything runs
# offline against data/fixtures.

# --- switches -------------------------------------------------------
# Unset or 0 = stubbed. 1 = real Azure calls.
AGENTIC_ITOPS_LIVE_AZURE=0
AGENTIC_ITOPS_LIVE_SEARCH=0

# --- Azure Monitor / Resource Graph ---------------------------------
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOG_ANALYTICS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# --- Azure AI Search (agent #4 knowledge index) ---------------------
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX=agentic-itops-knowledge
# Prefer managed identity in any shared environment. A key here is for
# local development only.
AZURE_SEARCH_API_KEY=

# --- Azure AI Foundry -----------------------------------------------
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com/api/projects/<name>

# Agent ids, populated after provisioning from agents/*/agent.yaml
AGENT_ID_OPS_ORCHESTRATOR=
AGENT_ID_RCA_INVESTIGATOR=
AGENT_ID_RUNBOOK_MEMORY=
AGENT_ID_REMEDIATION_PLANNER=
AGENT_ID_INCIDENT_COMMS=

# --- code skills deployed as Azure Functions ------------------------
AGENTIC_ITOPS_SKILL_BASE_URL=https://<func-app>.azurewebsites.net/api

# --- MCP ------------------------------------------------------------
AZURE_MONITOR_MCP_URL=
