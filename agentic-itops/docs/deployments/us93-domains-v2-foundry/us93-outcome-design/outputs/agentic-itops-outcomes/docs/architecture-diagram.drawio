        </mxCell>
        <mxCell id="sequence-note" value="Arrows are logical handoffs. 00 coordinates specialists; they do not call each other.&#10;Native A2A or a guarded gateway must prove intermediate validation and budget control at P0.&#10;Search/publisher and SQL/Blob are grouped for readability, not single resources." vertex="1" parent="1" style="text;html=0;fontColor=#000000;fontSize=17;align=left;">
          <mxGeometry as="geometry" x="40" y="730" width="1700" height="130" />
