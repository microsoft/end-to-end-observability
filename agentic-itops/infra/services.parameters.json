    "reviewApplicationClientId": {"value": "${ITOPS_REVIEW_APPLICATION_CLIENT_ID}"},
    "serviceApplicationClientId": {"value": "${ITOPS_SERVICE_APPLICATION_CLIENT_ID}"}
  }
}
