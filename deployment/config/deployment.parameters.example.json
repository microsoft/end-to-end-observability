{
  "$comment": "Central config for the end-to-end SRE Agent deployment orchestrator. Copy to deployment.parameters.json and fill in. Never commit the filled-in copy (see .gitignore) - it contains real tenant/subscription IDs.",

  "ring": "sandbox",
  "location": "eastus2",

  "subscriptionId": "<workload-subscription-guid>",
  "managementSubscriptionId": "<management-subscription-guid>",
  "tenantId": "<entra-tenant-guid>",

  "logAnalyticsWorkspaceResourceId": "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/<law>",
  "remediationUamiResourceId": "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.ManagedIdentity/userAssignedIdentities/<uami>",

  "workbookResourceGroup": "<rg-for-workbooks>",

  "sreAgent": {
    "resourceGroup": "<rg-for-sre-agent>",
    "name": "<sre-agent-name>",
    "mode": "Review",
    "existingResourceId": ""
  },

  "autoGeneratedWorkbooks": {
    "enabled": false,
    "discoveryInventoryPath": ""
  },

  "requiredProviders": [
    "Microsoft.App",
    "Microsoft.AlertsManagement",
    "Microsoft.PolicyInsights"
  ],

  "terraformBackend": {
    "$comment": "Optional. Key/value pairs passed to 'terraform init -backend-config=...'. Leave empty {} to use each subproject's default/local backend. 'key' is auto-suffixed per component.",
    "resource_group_name": "",
    "storage_account_name": "",
    "container_name": ""
  }
}
