{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fictional:power-grid:inventory:v1",
  "title": "Local-only fictional Power Grid inventory record",
  "oneOf": [
    {"$ref": "#/$defs/part_master"},
    {"$ref": "#/$defs/storeroom_location"},
    {"$ref": "#/$defs/part_applicability"},
    {"$ref": "#/$defs/part_stock_txn"}
  ],
  "$defs": {
    "part_master": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "part_master_id", "part_key", "part_name", "stock_code", "part_class", "tracking_mode", "uom", "required_storage_class", "specification", "tracking_policy_note", "is_synthetic", "operational_use"],
      "properties": {
        "record_type": {"const": "part_master"},
        "part_master_id": {"type": "string", "pattern": "grid-part-[0-9a-f]{24}"},
        "part_key": {"type": "string", "minLength": 1},
        "part_name": {"type": "string", "minLength": 1},
        "stock_code": {"type": "string", "minLength": 1},
        "part_class": {"type": "string", "enum": ["transformer", "switch", "recloser", "switch_control", "cutout", "fuse", "insulator", "conductor", "cable", "accessory", "arrester", "meter", "protection_control"]},
        "tracking_mode": {"type": "string", "enum": ["serialized", "lot", "bulk"]},
        "uom": {"type": "string", "enum": ["each", "m", "kit"]},
        "required_storage_class": {"type": "string", "enum": ["outdoor_covered", "dry", "controlled_electronics"]},
        "specification": {"type": "string", "minLength": 1},
        "tracking_policy_note": {"type": "string", "minLength": 1},
        "is_synthetic": {"const": true},
        "operational_use": {"const": "prohibited"}
      }
    },
    "storeroom_location": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "location_id", "location_code", "location_name", "location_type", "grid_east_km", "grid_north_km", "grid_frame", "storage_classes_supported", "is_synthetic", "operational_use"],
      "properties": {
        "record_type": {"const": "storeroom_location"},
        "location_id": {"type": "string", "pattern": "grid-location-[0-9a-f]{24}"},
        "location_code": {"type": "string", "minLength": 1},
        "location_name": {"type": "string", "minLength": 1},
        "location_type": {"type": "string", "enum": ["warehouse", "service_center", "staging", "crew_store"]},
        "grid_east_km": {"type": "number", "minimum": -50, "maximum": 50},
        "grid_north_km": {"type": "number", "minimum": -50, "maximum": 50},
        "grid_frame": {"const": "fictional local Austin-area km frame; no geolocation"},
        "storage_classes_supported": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["outdoor_covered", "dry", "controlled_electronics"]}},
        "aisle": {"type": "string", "minLength": 1},
        "rack": {"type": "string", "minLength": 1},
        "shelf": {"type": "string", "minLength": 1},
        "bin_code": {"type": "string", "minLength": 1},
        "is_synthetic": {"const": true},
        "operational_use": {"const": "prohibited"}
      }
    },
    "part_applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "part_applicability_id", "part_master_id", "part_key", "asset_type", "asset_config_code", "quantity_per_assembly", "fit_spec_code", "fitment_claim", "is_synthetic", "operational_use"],
      "properties": {
        "record_type": {"const": "part_applicability"},
        "part_applicability_id": {"type": "string", "pattern": "grid-fit-[0-9a-f]{24}"},
        "part_master_id": {"type": "string", "pattern": "grid-part-[0-9a-f]{24}"},
        "part_key": {"type": "string", "minLength": 1},
        "asset_type": {"type": "string", "enum": ["distribution_transformer", "switch", "recloser", "fused_lateral", "overhead_line", "underground_circuit", "service_connection"]},
        "asset_config_code": {"type": "string", "minLength": 1},
        "quantity_per_assembly": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "fit_spec_code": {"type": "string", "minLength": 1},
        "fitment_claim": {"const": "fictional illustrative grouping; not verified compatibility"},
        "is_synthetic": {"const": true},
        "operational_use": {"const": "prohibited"}
      }
    },
    "part_stock_txn": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "part_stock_txn_id", "part_master_id", "location_id", "transaction_type", "quantity", "uom", "entry_key", "is_synthetic", "operational_use"],
      "properties": {
        "record_type": {"const": "part_stock_txn"},
        "part_stock_txn_id": {"type": "string", "pattern": "grid-txn-[0-9a-f]{24}"},
        "part_master_id": {"type": "string", "pattern": "grid-part-[0-9a-f]{24}"},
        "location_id": {"type": "string", "pattern": "grid-location-[0-9a-f]{24}"},
        "transaction_type": {"type": "string", "enum": ["opening_balance", "issue", "receipt"]},
        "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "uom": {"type": "string", "enum": ["each", "m", "kit"]},
        "entry_key": {"type": "string", "minLength": 1},
        "is_synthetic": {"const": true},
        "operational_use": {"const": "prohibited"}
      }
    }
  }
}
