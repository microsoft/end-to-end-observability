{
  "format": "asre-agent-assets-map/v1",
  "description": "Render contract for the agent assets. The committed assets carry the synthetic fixture values of tests/fixtures/context.synthetic.json as sentinels. Rendering replaces, in one longest-first pass over every file under roots, each rule value of that fixture with the same value of the target context: an exact match yields the exact target value, an all-lowercase match yields the lowercase target value, any other casing fails. Files in inert may keep sentinels (Native/ServiceNow assets pinned to synthetic incident data, never deployed by the Common profile); every other rendered file must contain no sentinel after a non-synthetic render.",
  "source_context": "tests/fixtures/context.synthetic.json",
  "roots": [
    "agent",
    "contracts",
    "operations/contracts",
    "config/native-incident-runtime.json"
  ],
  "inert": [
    "agent/hooks/review-case-policy.py",
    "agent/instructions/incident-review.md",
    "agent/knowledge/asre-servicenow-review-v1.md",
    "agent/workflows/azure-monitor-review.json",
    "agent/workflows/native-review.json",
    "config/native-incident-runtime.json"
  ],
  "sentinel_patterns": [
    "(?<![0-9A-Za-z])00000[0-9]{3}-000a-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![0-9A-Za-z])",
    "(?<![0-9a-f])0{24}[0-9a-f]{8}(?![0-9a-f])",
    "[.-](?:0a1b2c3d\\.4e5f6a7b|9a8b7c6d\\.5e4f3a2b)\\.",
    "(?:example|alt)-instance\\.service-now\\.com"
  ],
  "rules": [
    "agent.endpoint",
    "agent.resource_id",
    "identities.agent.client_id",
    "identities.agent.principal_id",
    "identities.agent.resource_id",
    "identities.bootstrap.client_id",
    "identities.bootstrap.principal_id",
    "identities.bootstrap.resource_id",
    "identities.collector.client_id",
    "identities.collector.principal_id",
    "identities.collector.resource_id",
    "identities.pull.client_id",
    "identities.pull.principal_id",
    "identities.pull.resource_id",
    "identities.runner.client_id",
    "identities.runner.principal_id",
    "identities.runner.resource_id",
    "key_vault.name",
    "key_vault.uri",
    "log_analytics.customer_id",
    "log_analytics.resource_id",
    "name_suffix",
    "operator_object_id",
    "recovery_vault.resource_id",
    "registry.login_server",
    "registry.name",
    "resource_group_ids.backup",
    "resource_group_ids.control",
    "resource_group_ids.linux",
    "resource_group_ids.patch",
    "servicenow.api_base",
    "servicenow.assignment_group",
    "servicenow.client_id",
    "servicenow.configuration_items.backup",
    "servicenow.configuration_items.linux",
    "servicenow.configuration_items.patch",
    "servicenow.facade_client_id",
    "servicenow.origin",
    "storage.account_name",
    "storage.blob_endpoint",
    "storage.table_endpoint",
    "subscription_id",
    "targets.backup.resource_id",
    "targets.linux.resource_id",
    "targets.patch.resource_id",
    "tenant_id"
  ]
}
