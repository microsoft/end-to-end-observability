[Unit]
Description=ASRE bounded demonstration workload
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=asredemo
Group=asredemo
ExecStart=/usr/bin/python3 /usr/local/lib/asre-demo/workload.py
Restart=on-failure
RestartSec=10
MemoryAccounting=true
MemoryHigh=96M
MemoryMax=128M
MemorySwapMax=0
OOMPolicy=stop
CPUQuota=50%
TasksMax=32
LimitNOFILE=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/asre-demo/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=asre-demo

[Install]
WantedBy=multi-user.target
