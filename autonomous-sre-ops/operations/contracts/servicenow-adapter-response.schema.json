{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asre-demo:servicenow-adapter-response:1",
  "title": "Version 1 scripted REST response; native authentication failures use the platform envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["result"],
  "properties": {
    "result": {
      "oneOf": [
        {"$ref": "#/$defs/health"},
        {"$ref": "#/$defs/context"},
        {"$ref": "#/$defs/write"},
        {"$ref": "#/$defs/updates"},
        {"$ref": "#/$defs/error"}
      ]
    }
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "maxLength": 36},
    "sysId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "nativeTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$",
      "description": "Native ServiceNow internal UTC timestamp, not an RFC3339 string."
    },
    "caseReference": {"$ref": "urn:asre-demo:servicenow-case:1#/properties/case_reference"},
    "choice": {
      "type": "object", "additionalProperties": false, "required": ["value", "label"],
      "properties": {"value": {"type": "string"}, "label": {"type": "string"}}
    },
    "referenceLabel": {
      "type": "object", "additionalProperties": false, "required": ["sys_id", "label"],
      "properties": {"sys_id": {"$ref": "#/$defs/sysId"}, "label": {"type": "string"}}
    },
    "health": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "instance", "scope", "execution_mode", "azure_mutations_exposed", "human_approval_enabled", "trusted_verifier_bound", "feedback", "agent_continuation"],
      "properties": {
        "version": {"type": "string"},
        "instance": {"const": "example-instance"},
        "scope": {"const": "x_0000000_asre"},
        "execution_mode": {"const": "Review"},
        "azure_mutations_exposed": {"const": false},
        "human_approval_enabled": {"const": false},
        "trusted_verifier_bound": {"type": "boolean"},
        "feedback": {"type": "string"},
        "agent_continuation": {"type": "string"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["episode_id", "case_reference", "resource_id", "mode", "signal_family", "state", "assignment_group", "ci", "priority", "short_description", "description", "revision", "updated_at", "investigation_reference", "evidence", "instance_url"],
      "properties": {
        "episode_id": {"$ref": "#/$defs/uuid"},
        "case_reference": {"$ref": "#/$defs/caseReference"},
        "resource_id": {"$ref": "urn:asre-demo:servicenow-case:1#/properties/resource_id"},
        "mode": {"enum": ["reactive", "proactive"]},
        "signal_family": {"$ref": "urn:asre-demo:servicenow-case:1#/properties/signal_family"},
        "state": {"$ref": "#/$defs/choice"},
        "assignment_group": {"$ref": "#/$defs/referenceLabel"},
        "ci": {"$ref": "#/$defs/referenceLabel"},
        "priority": {"$ref": "#/$defs/choice"},
        "short_description": {"type": "string", "maxLength": 160},
        "description": {"type": "string", "maxLength": 8000},
        "revision": {"type": "string", "pattern": "^[0-9]+$"},
        "updated_at": {"$ref": "#/$defs/nativeTime"},
        "investigation_reference": {"type": ["string", "null"], "maxLength": 1000},
        "evidence": {"$ref": "urn:asre-demo:servicenow-case:1"},
        "instance_url": {"type": "string"}
      }
    },
    "auditReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_version", "receipt_id", "namespace", "episode_id", "case_reference", "resource_id", "action_name", "action_request_id", "proposal_fingerprint", "journal_sys_id", "audited_at", "expires_at", "human_approval", "execution_authorized"],
      "properties": {
        "receipt_version": {"const": "1.0"},
        "receipt_id": {"$ref": "#/$defs/sysId"},
        "namespace": {"const": "asre-demo-v1"},
        "episode_id": {"$ref": "#/$defs/uuid"},
        "case_reference": {"$ref": "#/$defs/caseReference"},
        "resource_id": {"$ref": "urn:asre-demo:servicenow-case:1#/properties/resource_id"},
        "action_name": {"enum": ["recover_workload", "recover_selected_patch", "recover_guest_agent_and_backup"]},
        "action_request_id": {"$ref": "#/$defs/uuid"},
        "proposal_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "journal_sys_id": {"$ref": "#/$defs/sysId"},
        "audited_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "human_approval": {"const": "not_recorded"},
        "execution_authorized": {"const": false}
      }
    },
    "write": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "episode_id", "write_request_id"],
      "properties": {
        "outcome": {"enum": ["applied", "already_applied", "unknown", "not_applied"]},
        "episode_id": {"$ref": "#/$defs/uuid"},
        "write_request_id": {"$ref": "#/$defs/uuid"},
        "case_reference": {"$ref": "#/$defs/caseReference"},
        "journal_sys_id": {"$ref": "#/$defs/sysId"},
        "event_id": {"$ref": "#/$defs/sysId"},
        "delivery": {"const": "received_not_answered"},
        "audit_receipt": {"$ref": "#/$defs/auditReceipt"},
        "message": {"type": "string"},
        "error_code": {"type": "string"},
        "reason": {"type": "string"},
        "state": {"$ref": "#/$defs/choice"},
        "recovery_owner": {"const": "manual"}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"enum": ["applied", "already_applied"]}}}, "then": {"required": ["case_reference"]}},
        {"if": {"properties": {"outcome": {"const": "unknown"}}}, "then": {"required": ["message"]}},
        {"if": {"properties": {"outcome": {"const": "not_applied"}}}, "then": {"required": ["error_code"]}}
      ]
    },
    "updates": {
      "type": "object", "additionalProperties": false,
      "required": ["feedback_version", "context", "events", "next_cursor", "has_more", "next_poll"],
      "properties": {
        "feedback_version": {"const": "1.0"},
        "context": {"$ref": "#/$defs/context"},
        "events": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["event_id", "kind", "actor", "observed_at", "content", "disposition"],
            "properties": {
              "event_id": {"$ref": "#/$defs/sysId"},
              "kind": {"const": "work_note"},
              "actor": {"type": "string"},
              "observed_at": {"$ref": "#/$defs/nativeTime"},
              "content": {"type": "string", "maxLength": 8000},
              "disposition": {"enum": ["pending_delivery", "blocked_sensitive_content", "blocked_oversized_content"]}
            }
          }
        },
        "next_cursor": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
        "has_more": {"type": "boolean"},
        "next_poll": {"type": "string"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["error"],
      "properties": {
        "error": {
          "type": "object", "additionalProperties": false, "required": ["code", "message", "write_request_id"],
          "properties": {
            "code": {"type": "string"}, "message": {"type": "string"},
            "write_request_id": {"type": ["string", "null"], "format": "uuid", "maxLength": 36}
          }
        }
      }
    }
  }
}
